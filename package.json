{
  "name": "sharemoney",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mobile",
    "web"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "bootstrap": "npm install --workspaces --include-workspace-root",
    "dev:mobile": "npm run start --workspace=mobile",
    "dev:server": "supabase functions serve --env-file supabase/.env",
    "dev:web": "npm run dev --workspace=web",
    "test:invite-regression:sql": "bash scripts/test-invite-regression-sql.sh",
    "test:invite-regression:api": "node supabase/tests/invite-reconciliation/api/run-api-regression.mjs",
    "test:invite-regression:local": "bash scripts/test-invite-regression-local.sh"
  },
  "devDependencies": {
    "imagemin": "^9.0.1",
    "imagemin-pngquant": "^10.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "sharp": "^0.34.5",
    "supabase": "^2.72.8"
  }
}