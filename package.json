{
  "name": "sharedmoney",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "mobile",
    "web"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "bootstrap": "npm install --workspaces --include-workspace-root",
    "dev:mobile": "npm run start --workspace=mobile",
    "dev:server": "supabase functions serve --env-file supabase/.env",
    "dev:web": "npm run dev --workspace=web",
    "test": "npm run test:all",
    "test:all": "npm run test:web && npm run test:mobile && npm run test:deno",
    "test:web": "npm run test --workspace=web",
    "test:mobile": "npm run test:android-push-config --workspace=mobile && npm run test:sentry-build-config --workspace=mobile && npm run test:expo-public-config --workspace=mobile && npm run test:icon-imports --workspace=mobile",
    "test:deno": "deno test --allow-env tests/ supabase/functions/",
    "typecheck": "npm run typecheck:mobile && npm run typecheck:web",
    "typecheck:mobile": "npx tsc --noEmit -p mobile/tsconfig.json",
    "typecheck:web": "npm run build --workspace=web",
    "lint": "npm run lint:web",
    "lint:web": "npm run lint --workspace=web",
    "verify:google-branding": "node scripts/verify-google-branding.mjs"
  },
  "overrides": {
    "undici": "6.28.1"
  },
  "devDependencies": {
    "imagemin": "^9.0.1",
    "imagemin-pngquant": "^10.0.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0"
  }
}
