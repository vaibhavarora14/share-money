# Supabase Configuration
# Get these values from: Supabase Dashboard > Settings > API
# 
# IMPORTANT: Expo requires the EXPO_PUBLIC_ prefix for environment variables
# to be accessible in the app. Without this prefix, variables won't be available.
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth. Use the same Web OAuth client ID configured in Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# API URL - Supabase Edge Functions endpoint
# For local development with Supabase CLI:
# EXPO_PUBLIC_API_URL=http://localhost:54321/functions/v1
# For production (replace YOUR_PROJECT_REF with your Supabase project reference):
# EXPO_PUBLIC_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

# App URL - base for shareable group invite links (and Universal/App Links)
# For local development:
# EXPO_PUBLIC_APP_URL=http://localhost:8081
# For production:
# EXPO_PUBLIC_APP_URL=https://sharedmoney.app/app

# Default Currency (optional - defaults to INR)
EXPO_PUBLIC_DEFAULT_CURRENCY=INR

# Sentry Configuration
# DSN for Sentry React Native SDK. If this is not set, Sentry will not be
# initialized and errors/logs will not be sent.
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn

# PostHog Configuration (SharedMoney Production project — NOT Paisewise)
# Public project API key from PostHog project 563625. If unset, PostHog will
# not be initialized (same no-op pattern as a missing Sentry DSN).
# Store the real value in EAS Production/Preview secrets and local .env —
# never commit the full key.
# EXPO_PUBLIC_POSTHOG_KEY=phc_your_sharedmoney_production_key
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Build-only credential used to upload source maps. Store the real value in
# EAS as a sensitive production variable and in gitignored .env.local for
# local release builds. Never prefix this value with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Optional: Explicit environment for Sentry (e.g. development, staging, production).
# If not set, the app will use "development" in dev builds and "production" in
# release builds.
# EXPO_PUBLIC_SENTRY_ENV=development

# Optional: Sampling rates for Sentry performance and Session Replay. These are
# parsed as numbers and default to the following values if not provided:
# - EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE: 0.1
# - EXPO_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE: 0.1
# - EXPO_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE: 1.0
# EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# EXPO_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
# EXPO_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Internal signed verification builds only. Production rejects this flag.
# EXPO_PUBLIC_ENABLE_SENTRY_DIAGNOSTICS=true
