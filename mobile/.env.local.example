# Local Supabase Configuration for Mobile App
# Copy this to .env in mobile directory

EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# Keep this server-side build token in a gitignored .env.local file only.
# Never prefix it with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SharedMoney Production PostHog (project 563625). Optional for local runs;
# required in EAS production/preview builds for mobile analytics.
# EXPO_PUBLIC_POSTHOG_KEY=phc_your_sharedmoney_production_key
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Supabase Edge Functions API URL
# Local: http://localhost:54321/functions/v1
# Production: https://YOUR_PROJECT_REF.supabase.co/functions/v1
EXPO_PUBLIC_API_URL=your_api_url
